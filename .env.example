# Telnyx API Configuration
TELNYX_API_KEY=KEY018..._YOUR_TELNYX_API_KEY
TELNYX_PHONE_NUMBER=+18005550199
TELNYX_CONNECTION_ID=YOUR_CALL_CONTROL_APPLICATION_ID

# Telnyx WebRTC SIP Credentials (for in-browser two-way audio)
TELNYX_SIP_USERNAME=YOUR_SIP_USERNAME
TELNYX_SIP_PASSWORD=YOUR_SIP_PASSWORD

# Server Configuration
PORT=3000
NODE_ENV=development

# Optional Public Base URL (for webhooks via ngrok/localtunnel)
PUBLIC_URL=http://localhost:3000
